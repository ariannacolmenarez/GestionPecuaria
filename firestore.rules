rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permisos para la gestión pecuaria de la granja (online y offline)
    match /farms/{farmId} {
      allow read, write: if true;
      
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Documento de verificación de conexión
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
